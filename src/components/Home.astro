---
// The home page markup, moved from docs/design/reference/reference-v-e.html almost as it is:
// the same elements, classes and inline styles. Only the text comes from the content file.
import type { Content } from '../content/he';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  t: Content;
}
const { t } = Astro.props;
// Hebrew (rtl) is the reference and its output is unchanged. English (ltr) is the same design mirrored:
// the portrait and its fade move to the other side, and the stat separators switch to the other edge.
const rtl = t.dir === 'rtl';
const portraitSide = rtl ? 'left' : 'right';
// The supplied portrait file has a 1px bright column at its right edge. In Hebrew that edge is the faded inner one;
// mirrored it would sit on the visible outer edge. The file stays as supplied: the English box starts 2px past the
// viewport edge and the hero (overflow: hidden) clips it.
const portraitOffset = rtl ? '0' : '-2px';
const portraitWidth = rtl ? '58%' : 'calc(58% + 2px)';
const portraitFade = rtl ? 'to left' : 'to right';
const overlayAngle = rtl ? '270deg' : '90deg';
const statSeparator = rtl ? 'border-left' : 'border-right';
const cubeData = {
  dir: t.dir,
  items: t.cube.items,
  groups: t.cube.groups,
  hintStart: t.cube.hintStart,
  hintEnd: t.cube.hintEnd,
};
// Scroll length of the pinned cube section. The reference used 320vh, which moved through the cube groups too quickly
// (Ron, 2026-10-19); this is the single place to change it. Each of the four groups gets 0.86 * (height - 100vh) / 4 of scroll.
const cubeSectionHeight = '500vh';
---
<div class="rn" dir={t.dir} style="background: #fff; color: var(--text); font-family: 'Open Sans', system-ui, sans-serif; font-size: 18px; line-height: 1.75;">

<Header t={t} />

<main id="top">

<section aria-labelledby="hero-title" style="position: relative; background: #0A0A0F; color: #fff; overflow: hidden;">
<div class="rn-portrait" style={`position: absolute; top: 0; bottom: 0; ${portraitSide}: ${portraitOffset}; width: ${portraitWidth}; background: #2B2B30; -webkit-mask-image: linear-gradient(${portraitFade}, transparent 0%, #000 38%); mask-image: linear-gradient(${portraitFade}, transparent 0%, #000 38%);`}>
<img src="/portrait.webp" alt={t.hero.portraitAlt} width="762" height="752" style="display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%;">
</div>
<div aria-hidden="true" style={`position: absolute; inset: 0; background: linear-gradient(${overlayAngle}, rgba(10,10,15,1) 36%, rgba(10,10,15,0.5) 62%, rgba(10,10,15,0.05) 100%);`}></div>
<div class="rn-in" style="position: relative; max-width: 1280px; margin: 0 auto; padding: 120px 32px 130px; box-sizing: border-box; min-height: 82vh; display: flex; flex-direction: column; justify-content: center;">
<p style="margin: 0 0 22px; font-size: 15px; font-weight: 600; letter-spacing: 0.16em; color: var(--gold);">{t.hero.eyebrow}</p>
<h1 id="hero-title" style="margin: 0; max-width: 13ch; font-family: 'Rubik', sans-serif; font-weight: 800; font-size: clamp(48px, 7vw, 96px); line-height: 1.02;">{t.hero.title}</h1>
<p style="margin: 28px 0 0; max-width: 36ch; font-size: 21px; line-height: 1.6; color: #D9D6CE;" set:html={t.hero.leadHtml}></p>
<div style="margin-top: 40px; display: flex; flex-wrap: wrap; gap: 14px;">
<a class="rn-btn" href="#achievements">{t.hero.ctaAchievements}</a>
<a class="rn-btn line" href="#projects">{t.hero.ctaProjects}</a>
</div>
</div>
</section>

<section aria-hidden="true" style="position: relative; height: 240px; background: var(--navy); overflow: hidden;"><canvas class="rn-stage" id="cv-a"></canvas></section>

<section id="about" aria-labelledby="about-title" style="background: #fff;">
<div style="max-width: 1280px; margin: 0 auto; padding: 110px 32px; display: flex; flex-wrap: wrap; gap: 64px; align-items: center;">
<div style="flex: 1 1 520px; min-width: 0;">
<h2 id="about-title" style="margin: 0 0 22px; font-family: 'Rubik', sans-serif; font-weight: 700; font-size: 44px; line-height: 1.15; color: #000;">{t.about.title}</h2>
<p style="margin: 0 0 16px; font-family: 'Rubik', sans-serif; font-size: 23px; line-height: 1.5; color: var(--ink);">{t.about.lead}</p>
<p style="margin: 0 0 16px;">{t.about.p1}</p>
<p style="margin: 0 0 28px;" set:html={t.about.p2Html}></p>
<a class="rn-btn dark" href="#path">{t.about.cta}</a>
</div>
<div style="flex: 1 1 400px; min-width: 0; display: flex; flex-wrap: wrap; gap: 0; background: var(--cream);">
<div style={`flex: 1 1 50%; box-sizing: border-box; padding: 36px 32px; border-bottom: 1px solid var(--line); ${statSeparator}: 1px solid var(--line);`}><div style="font-family: 'Rubik', sans-serif; font-weight: 800; font-size: 54px; line-height: 1; color: #000;">{t.about.stats[0].big}</div><div style="margin-top: 8px; color: var(--muted);" set:html={t.about.stats[0].labelHtml}></div></div>
<div style="flex: 1 1 50%; box-sizing: border-box; padding: 36px 32px; border-bottom: 1px solid var(--line);"><div style="font-family: 'Rubik', sans-serif; font-weight: 800; font-size: 54px; line-height: 1; color: #000;">{t.about.stats[1].big}</div><div style="margin-top: 8px; color: var(--muted);" set:html={t.about.stats[1].labelHtml}></div></div>
<div style={`flex: 1 1 50%; box-sizing: border-box; padding: 36px 32px; ${statSeparator}: 1px solid var(--line);`}><div style="font-family: 'Rubik', sans-serif; font-weight: 800; font-size: 54px; line-height: 1; color: #000;">{t.about.stats[2].big}</div><div style="margin-top: 8px; color: var(--muted);" set:html={t.about.stats[2].labelHtml}></div></div>
<div style="flex: 1 1 50%; box-sizing: border-box; padding: 36px 32px;"><div style="font-family: 'Rubik', sans-serif; font-weight: 800; font-size: 54px; line-height: 1; color: #000;">{t.about.stats[3].big}</div><div style="margin-top: 8px; color: var(--muted);" set:html={t.about.stats[3].labelHtml}></div></div>
</div>
</div>
</section>

<section id="achievements" aria-labelledby="ach-title" style={`position: relative; height: ${cubeSectionHeight}; background: var(--navy);`}>
<div class="rn-pin">
<canvas class="rn-stage" id="cv-main" role="img" aria-label={t.achievements.canvasAria}></canvas>
<div style="position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: 56px 32px 0; box-sizing: border-box; pointer-events: none;">
<p style="margin: 0 0 8px; font-size: 15px; font-weight: 600; letter-spacing: 0.16em; color: var(--gold);">{t.achievements.eyebrow}</p>
<h2 id="ach-title" style="margin: 0; font-family: 'Rubik', sans-serif; font-weight: 700; font-size: 40px; line-height: 1.15; color: #fff;">{t.achievements.title}</h2>
<p style="margin: 10px 0 0; font-size: 16px; color: #C9C7D6;"><span id="cube-hint">{t.cube.hintStart}</span></p>
</div>
<ul style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); margin: 0; padding: 0;">
{t.achievements.a11yList.map((item) => <li>{item}</li>)}
</ul>
</div>
</section>

<section id="domains" aria-labelledby="domains-title" style="background: #fff;">
<div style="max-width: 1280px; margin: 0 auto; padding: 110px 32px;">
<h2 id="domains-title" style="margin: 0 0 48px; font-family: 'Rubik', sans-serif; font-weight: 700; font-size: 44px; line-height: 1.15; color: #000; text-align: center;">{t.domains.title}</h2>
<div style="display: flex; flex-wrap: wrap; gap: 24px;">
{t.domains.cards.map((c) => (
<div style="flex: 1 1 300px; background: var(--cream); padding: 36px; border-top: 4px solid var(--gold);"><div style="font-family: 'Rubik', sans-serif; font-weight: 800; font-size: 56px; line-height: 1; color: #000;">{c.num}</div><h3 style="margin: 14px 0 8px; font-family: 'Rubik', sans-serif; font-weight: 600; font-size: 26px; color: var(--ink);" set:html={c.titleHtml}></h3><p style="margin: 0; color: var(--muted);" set:html={c.bodyHtml}></p></div>
))}
</div>
</div>
</section>

<section id="projects" aria-labelledby="projects-title" style="background: #fff;">
<div style="max-width: 1280px; margin: 0 auto; padding: 110px 32px 40px;">
<h2 id="projects-title" style="margin: 0 0 12px; font-family: 'Rubik', sans-serif; font-weight: 700; font-size: 44px; line-height: 1.15; color: #000; text-align: center;">{t.projects.title}</h2>
<p style="margin: 0 auto; max-width: 52ch; text-align: center; color: var(--muted);">{t.projects.sub}</p>
</div>
<div style="max-width: 1280px; margin: 0 auto; padding: 40px 32px 110px; display: flex; flex-direction: column; gap: 72px;">
<article style="display: flex; flex-wrap: wrap; gap: 56px; align-items: center;">
<div style="flex: 1 1 460px; min-width: 0;"><p style="margin: 0 0 8px; font-weight: 600; color: #8A6F12;" set:html={t.projects.items[0].metaHtml}></p><h3 style="margin: 0 0 14px; font-family: 'Rubik', sans-serif; font-weight: 700; font-size: 36px; color: var(--ink);" set:html={t.projects.items[0].titleHtml}></h3><p style="margin: 0 0 24px;" set:html={t.projects.items[0].bodyHtml}></p><a class="rn-btn" href={t.projects.items[0].ctaHref}>{t.projects.items[0].cta}</a></div>
<div aria-hidden="true" style="flex: 1 1 460px; min-width: 0; aspect-ratio: 16 / 10; background: var(--navy); display: flex; align-items: center; justify-content: center;"><span lang="en" style="font-family: 'Rubik', sans-serif; font-weight: 800; font-size: 56px; color: var(--gold); letter-spacing: 0.02em;">{t.projects.panels[0]}</span></div>
</article>
<article style="display: flex; flex-wrap: wrap-reverse; gap: 56px; align-items: center; flex-direction: row-reverse;">
<div style="flex: 1 1 460px; min-width: 0;"><p style="margin: 0 0 8px; font-weight: 600; color: #8A6F12;" set:html={t.projects.items[1].metaHtml}></p><h3 style="margin: 0 0 14px; font-family: 'Rubik', sans-serif; font-weight: 700; font-size: 36px; color: var(--ink);" set:html={t.projects.items[1].titleHtml}></h3><p style="margin: 0 0 24px;" set:html={t.projects.items[1].bodyHtml}></p><a class="rn-btn" href={t.projects.items[1].ctaHref}>{t.projects.items[1].cta}</a></div>
<div aria-hidden="true" style="flex: 1 1 460px; min-width: 0; aspect-ratio: 16 / 10; background: var(--cream); display: flex; align-items: center; justify-content: center;"><span style="font-family: 'Rubik', sans-serif; font-weight: 800; font-size: 120px; line-height: 1; color: #000;">{t.projects.panels[1]}</span></div>
</article>
<article style="display: flex; flex-wrap: wrap; gap: 56px; align-items: center;">
<div style="flex: 1 1 460px; min-width: 0;"><p style="margin: 0 0 8px; font-weight: 600; color: #8A6F12;" set:html={t.projects.items[2].metaHtml}></p><h3 style="margin: 0 0 14px; font-family: 'Rubik', sans-serif; font-weight: 700; font-size: 36px; color: var(--ink);" set:html={t.projects.items[2].titleHtml}></h3><p style="margin: 0 0 24px;" set:html={t.projects.items[2].bodyHtml}></p><a class="rn-btn" href={t.projects.items[2].ctaHref}>{t.projects.items[2].cta}</a></div>
<div aria-hidden="true" style="flex: 1 1 460px; min-width: 0; aspect-ratio: 16 / 10; background: #111; display: flex; align-items: center; justify-content: center;"><span lang="en" style="font-family: 'Frank Ruhl Libre', serif; font-size: 52px; color: #fff; letter-spacing: 0.06em;">{t.projects.panels[2]}</span></div>
</article>
</div>
</section>

<section aria-labelledby="quote-b" style="position: relative; height: 340px; background: var(--navy); overflow: hidden;"><canvas class="rn-stage" id="cv-b" aria-hidden="true"></canvas><div style="position: relative; z-index: 1; height: 100%; display: flex; align-items: center; justify-content: center; pointer-events: none;"><p id="quote-b" style="margin: 0; font-family: 'Rubik', sans-serif; font-weight: 700; font-size: clamp(30px, 4vw, 48px); color: #fff; text-align: center;" set:html={t.quote.html}></p></div></section>

<section id="path" aria-labelledby="path-title" style="background: var(--gray);">
<div style="max-width: 1280px; margin: 0 auto; padding: 110px 32px;">
<h2 id="path-title" style="margin: 0 0 48px; font-family: 'Rubik', sans-serif; font-weight: 700; font-size: 44px; line-height: 1.15; color: #000; text-align: center;">{t.path.title}</h2>
<div style="display: flex; flex-wrap: wrap; gap: 24px;">
{t.path.cards.map((c) => (
<div style="flex: 1 1 280px; background: #fff; padding: 32px; border-top: 4px solid var(--gold);"><div style="font-weight: 600; color: #8A6F12;" set:html={c.dateHtml}></div><h3 style="margin: 8px 0; font-family: 'Rubik', sans-serif; font-weight: 600; font-size: 22px; color: var(--ink);" set:html={c.titleHtml}></h3><p style="margin: 0; color: var(--muted);" set:html={c.subHtml}></p></div>
))}
</div>
</div>
</section>

<section id="articles" aria-labelledby="articles-title" style="background: #fff;">
<div style="max-width: 1280px; margin: 0 auto; padding: 110px 32px;">
<h2 id="articles-title" style="margin: 0 0 12px; font-family: 'Rubik', sans-serif; font-weight: 700; font-size: 44px; line-height: 1.15; color: #000; text-align: center;">{t.articles.title}</h2>
<p style="margin: 0 auto 48px; max-width: 52ch; text-align: center; color: var(--muted);">{t.articles.sub}</p>
<div style="display: flex; flex-wrap: wrap; gap: 24px;">
{t.articles.cards.map((c) => (
<article style="flex: 1 1 300px; border: 1px solid var(--line); padding: 32px;"><div style="font-weight: 600; color: #8A6F12;" set:html={c.metaHtml}></div><h3 style="margin: 10px 0 0; font-family: 'Rubik', sans-serif; font-weight: 600; font-size: 23px; color: var(--ink);" set:html={c.titleHtml}></h3></article>
))}
</div>
</div>
</section>

<section aria-hidden="true" style="position: relative; height: 300px; background: var(--navy); overflow: hidden;"><canvas class="rn-stage" id="cv-c"></canvas></section>

<section aria-labelledby="cta-title" style="background: var(--navy); color: #fff;">
<div style="max-width: 1280px; margin: 0 auto; padding: 96px 32px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px;">
<div><h2 id="cta-title" style="margin: 0 0 8px; font-family: 'Rubik', sans-serif; font-weight: 700; font-size: 40px; line-height: 1.2;">{t.cta.title}</h2><p style="margin: 0; color: #C9C7D6;">{t.cta.sub}</p></div>
<a class="rn-btn" href={t.nav.linkedinHref}>{t.cta.button}</a>
</div>
</section>
</main>

<Footer t={t} />

</div>
<script is:inline type="application/json" id="cube-data" set:html={JSON.stringify(cubeData)}></script>
