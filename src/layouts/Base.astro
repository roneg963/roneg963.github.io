---
// Fonts are self-hosted (fontsource): the same families and weights as the reference, no third-party requests.
import '@fontsource/rubik/400.css';
import '@fontsource/rubik/500.css';
import '@fontsource/rubik/600.css';
import '@fontsource/rubik/700.css';
import '@fontsource/rubik/800.css';
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/600.css';
import '@fontsource/frank-ruhl-libre/400.css';
// The reference's own <style> block, unchanged.
import '../styles/reference.css';

// Search engines are kept out until launch. RN-040 flips this single constant (Ron approves publishing).
const INDEXABLE = false;

interface Props {
  lang: 'he' | 'en';
  title: string;
}
const { lang, title } = Astro.props;
const dir = lang === 'he' ? 'rtl' : 'ltr';
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!INDEXABLE && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
