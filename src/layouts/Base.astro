---
// Fonts are self-hosted (fontsource): the same families and weights as the reference, no third-party requests.
import '@fontsource/rubik/400.css';
import '@fontsource/rubik/500.css';
import '@fontsource/rubik/600.css';
import '@fontsource/rubik/700.css';
import '@fontsource/rubik/800.css';
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/600.css';
import '@fontsource/frank-ruhl-libre/400.css';
// The reference's own <style> block, unchanged.
import '../styles/reference.css';
// Phone-width adjustments only (max-width 700px); desktop keeps the reference look.
import '../styles/narrow.css';
import SeoHead from '../components/SeoHead.astro';
// The few font files the first screen of a home page needs are preloaded (same files the CSS already uses),
// so the hero text does not shift when the fonts arrive.
import rubikLatin800 from '@fontsource/rubik/files/rubik-latin-800-normal.woff2?url';
import rubikHebrew800 from '@fontsource/rubik/files/rubik-hebrew-800-normal.woff2?url';
import openSansLatin400 from '@fontsource/open-sans/files/open-sans-latin-400-normal.woff2?url';
import openSansHebrew400 from '@fontsource/open-sans/files/open-sans-hebrew-400-normal.woff2?url';
import frankLatin400 from '@fontsource/frank-ruhl-libre/files/frank-ruhl-libre-latin-400-normal.woff2?url';

// Search engines are kept out until launch. RN-040 flips this single constant (Ron approves publishing).
const INDEXABLE = false;

interface Props {
  lang: 'he' | 'en';
  title: string;
  // The path of this page in each language, for example { he: '/', en: '/en/' }.
  alternates: { he: string; en: string };
}
const { lang, title, alternates } = Astro.props;
const dir = lang === 'he' ? 'rtl' : 'ltr';
const isHome = alternates.he === '/';
const preloadFonts = lang === 'he' ? [rubikHebrew800, rubikLatin800, openSansHebrew400, frankLatin400] : [rubikLatin800, openSansLatin400, frankLatin400];
const abs = (path: string) => new URL(path, Astro.site).href;
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* לא להסיר — האימות של Search Console תלוי בה */}
    <meta name="google-site-verification" content="AsV07tyxY3IMmpOb_4MZnqyvfuBIUWbp3G3pxCnxe-w" />
    {!INDEXABLE && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    {isHome && preloadFonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <SeoHead lang={lang} title={title} url={abs(alternates[lang])} profile={alternates.he === '/'} />
    <link rel="icon" href="data:," />
    <link rel="canonical" href={abs(alternates[lang])} />
    <link rel="alternate" hreflang="he-IL" href={abs(alternates.he)} />
    <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(alternates.he)} />
  </head>
  <body>
    <slot />
  </body>
</html>
