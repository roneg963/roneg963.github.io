---
import Page from '../components/Page.astro';
import { he } from '../content/he';
import { privacy } from '../content/privacy';
const c = privacy.he;
---
<Page t={he} title={c.title} heading={c.heading} alternates={{ he: '/privacy/', en: '/en/privacy/' }}>
  <p class="rn-muted">{c.updated}</p>
  {c.sections.map((s) => (<><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p set:html={p} />)}</>))}
</Page>
