---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import { he } from '../content/he';
---
<Base lang="he" title={he.meta.title} alternates={{ he: '/', en: '/en/' }}>
  <Home t={he} />
</Base>
<script>
  // The 3D code (three + the scenes) loads after the page content, and only when a 3D canvas comes within
  // 1000px of the screen. With ?freeze=1 (screenshot tests) it loads right after the page.
  let started = false;
  const start = () => {
    if (started) return;
    started = true;
    near?.disconnect();
    // Two steps so that loading three and building the scenes are separate tasks.
    import('three').then(() => setTimeout(() => import('../scripts/scene.js'), 50));
  };
  let near: IntersectionObserver | undefined;
  const arm = () => {
    if (/[?&]freeze=1/.test(location.search) || !('IntersectionObserver' in window)) return start();
    near = new IntersectionObserver((entries) => { if (entries.some((e) => e.isIntersecting)) start(); }, { rootMargin: '1000px 0px' });
    ['cv-main', 'cv-a', 'cv-b', 'cv-c'].forEach((id) => { const el = document.getElementById(id); if (el) near!.observe(el); });
  };
  if (document.readyState === 'complete') arm();
  else window.addEventListener('load', arm, { once: true });
</script>
