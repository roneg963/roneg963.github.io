---
import Page from '../components/Page.astro';
import { he } from '../content/he';
import { accessibility } from '../content/accessibility';
const c = accessibility.he;
---
<Page t={he} title={c.title} heading={c.heading} alternates={{ he: '/accessibility/', en: '/en/accessibility/' }}>
  {c.sections.map((s) => (<><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p set:html={p} />)}</>))}
</Page>
